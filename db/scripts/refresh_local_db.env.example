# Settings for db/scripts/refresh_local_db.py.
#
# Copy this file to refresh_local_db.env (same folder; gitignored) and fill it in,
# or keep it anywhere private and pass --env-file <path>. Environment variables
# with the same names override anything in the file. Blank values use the default.

# Production backup download (only used with --download). Ask an InteropHub
# maintainer for the credentials.
INTEROPHUB_BACKUP_URL=https://informatics.immregistries.org/dumps/interophub_backup.sql.gz
INTEROPHUB_BACKUP_USER=
INTEROPHUB_BACKUP_PASSWORD=

# Where the downloaded backup and the refresh state file live.
# Default: next to your InteropHub checkout (its parent folder).
INTEROPHUB_BACKUP_PATH=
INTEROPHUB_REFRESH_STATE_PATH=

# Local MySQL account used to drop/recreate/import the database. Needs rights to
# DROP and CREATE the database (root is simplest on a dev machine).
INTEROPHUB_LOCAL_MYSQL_HOST=127.0.0.1
INTEROPHUB_LOCAL_MYSQL_PORT=3306
INTEROPHUB_LOCAL_MYSQL_USER=root
INTEROPHUB_LOCAL_MYSQL_PASSWORD=
INTEROPHUB_LOCAL_DB_NAME=interophub
